{
  "name": "script-glow",
  "productName": "Script Glow",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "start": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.*",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --config desktop/builder.cjs --publish never",
    "dist:dir": "npm run build && electron-builder --config desktop/builder.cjs --dir --publish never",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "number-to-words": "1.2.4",
    "onnxruntime-node": "1.21.0",
    "pdfjs-dist": "5.4.296"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "electron@44.4.3": true
  },
  "overrides": {
    "sharp": "file:./stubs/sharp"
  }
}
